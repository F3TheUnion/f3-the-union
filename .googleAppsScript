function buildUnionRegionQuery() {
  const members = fetchAllSlackMembers_();

  const names = new Set();
  members.forEach(m => {
    if (m.deleted || m.is_bot || m.id === 'USLACKBOT') return;
    const p = m.profile || {};
    const name = (p.display_name || p.real_name || '').trim();
    if (name) names.add(name);
  });

  const sorted = [...names].sort((a, b) => a.toLowerCase().localeCompare(b.toLowerCase()));
  const inList = sorted
    .map(n => `'${n.toLowerCase().replace(/'/g, "''")}'`)  // lowercase + escape apostrophes
    .join(',\n  ');

  const sql =
`SELECT DISTINCT user_id, home_region_id, f3_name
FROM \`f3data.analytics.attendance_info\`
WHERE LOWER(TRIM(f3_name)) IN (
  ${inList}
)
ORDER BY f3_name;`;

  Logger.log('PAX count: ' + sorted.length);
  Logger.log(sql);
  return sql;
}

// Paginates users.list so you get the whole workspace, not just the first page.
function fetchAllSlackMembers_() {
  const members = [];
  let cursor = '';
  do {
    const url = 'https://slack.com/api/users.list?limit=200'
      + (cursor ? '&cursor=' + encodeURIComponent(cursor) : '');
    const res = UrlFetchApp.fetch(url, {
      headers: { Authorization: 'Bearer ' + slackBotToken },
      muteHttpExceptions: true,
    });
    const data = JSON.parse(res.getContentText());
    if (!data.ok) throw new Error('Slack API error: ' + data.error);
    (data.members || []).forEach(m => members.push(m));
    cursor = data.response_metadata && data.response_metadata.next_cursor;
  } while (cursor);
  return members;
}
const SHEET_NAME = 'NewKotterList'

function readKotterData() {
  var conn = Jdbc.getConnection(url+'?useSSL=false', Database_username, Database_password);
  var stmt = conn.createStatement();

  var sql = `
WITH last_eligible AS (
  SELECT
    pax,
    \`Date\` AS last_post_date,
    AO     AS last_post_ao,
    ROW_NUMBER() OVER (
      PARTITION BY pax
      ORDER BY \`Date\` DESC
    ) AS rn
  FROM attendance_view
  WHERE pax NOT IN ('d')
    AND AO NOT IN ('the_cafeteria','the_breakroom','the_forge')
),
kotter AS (
  SELECT
    pax,
    last_post_date,
    last_post_ao,
    DATEDIFF(CURRENT_DATE(), last_post_date) AS days_since_last_post
  FROM last_eligible
  WHERE rn = 1
)
SELECT
  pax,
  last_post_date,
  days_since_last_post,
  last_post_ao
FROM kotter
WHERE (days_since_last_post BETWEEN 14 AND 28)
   OR (days_since_last_post BETWEEN 49 AND 63)
ORDER BY last_post_ao, days_since_last_post
`;

  var results = stmt.executeQuery(sql);

  var metaData=results.getMetaData();
  var numCols = metaData.getColumnCount();
  var spreadsheet = SpreadsheetApp.getActive();
  var sheet = spreadsheet.getSheetByName(SHEET_NAME);
  var headerRow = sheet.getRange("1:1");
  sheet.clearContents();
  var arr=[];
  

  for (var col = 0; col < numCols; col++) {
    arr.push(metaData.getColumnName(col + 1));
  }
  
  sheet.appendRow(arr);


  while (results.next()) {
    arr=[];
    for (var col = 0; col < numCols; col++) {
      arr.push(results.getString(col + 1));
    }
    sheet.appendRow(arr);
  }
  
  results.close();
  stmt.close();
  sheet.autoResizeColumns(1, numCols+1);
} 

