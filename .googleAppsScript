/****************************************************
 * Returns a Slack userId for a given username.
 * - Normalizes the username
 * - Checks cache (persistent)
 * - If not cached, fetches from Slack
 * - Saves into cache
 ****************************************************/
function getSlackUserId(username) {
  const normalized = normalizeName(username);

  // 1. Check persistent cache
  const cachedId = getCachedUserId(normalized);
  if (cachedId) {
    Logger.log("cached"); 
    return cachedId;
  }
  Logger.log("not cached"); 

  // 2. Not cached → lookup from Slack API
  const userId = lookupSlackUserIdFromApi(username);

  // 3. Save to cache
  saveUserIdToCache(normalized, userId);

  return userId;
}


/****************************************************
 * Normalizes username: lowercase + remove spaces.
 ****************************************************/
function normalizeName(name) {
  return name.toLowerCase().replace(/\s+/g, "");
}


/****************************************************
 * Gets a cached Slack userId from Script Properties.
 ****************************************************/
function getCachedUserId(normalizedName) {
  const props = PropertiesService.getScriptProperties();
  return props.getProperty("slackUserId_" + normalizedName);
}


/****************************************************
 * Saves a Slack userId into persistent Script Properties.
 ****************************************************/
function saveUserIdToCache(normalizedName, userId) {
  const props = PropertiesService.getScriptProperties();
  props.setProperty("slackUserId_" + normalizedName, userId);
}


/****************************************************
 * Calls Slack API: users.list
 * Searches by normalized display name, real name, username
 ****************************************************/
function lookupSlackUserIdFromApi(name) {
  const slackToken = slackBotToken; // you must define slackBotToken

  const res = UrlFetchApp.fetch("https://slack.com/api/users.list", {
    method: "get",
    headers: {
      Authorization: "Bearer " + slackToken,
    },
    muteHttpExceptions: true,
  });

  const data = JSON.parse(res.getContentText());

  if (!data.ok) {
    throw new Error("Slack API error: " + data.error);
  }

  const target = normalizeName(name);

  for (const member of data.members) {
    if (!member.profile) continue;

    const displayNorm = normalizeName(member.profile.display_name || "");
    const realNorm    = normalizeName(member.profile.real_name || "");
    const userNorm    = normalizeName(member.name || "");

    // Match any normalized variant
    if (target === displayNorm || target === realNorm || target === userNorm) {
      return member.id; // success
    }
  }

  throw new Error("Slack user not found: " + name);
}

