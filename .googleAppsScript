function buildFactPaxEvents() {
  const ss = SpreadsheetApp.getActive();

  const paxSheet = ss.getSheetByName('pax');
  const kogSheet = ss.getSheetByName('26KoG');
  const mapSheet = ss.getSheetByName('26KoGScoring');

  let out = ss.getSheetByName('Fact_PaxEvents');
  if (!out) out = ss.insertSheet('Fact_PaxEvents');
  out.clearContents();

  /* ---------- helpers ---------- */

  const weekStart = d => {
    const dt = new Date(d);
    dt.setHours(0, 0, 0, 0);
    dt.setDate(dt.getDate() - ((dt.getDay() + 6) % 7));
    return Utilities.formatDate(
      dt,
      Session.getScriptTimeZone(),
      'yyyy-MM-dd'
    );
  };

  /* ---------- pax → team map ---------- */

  const paxTeam = {};
  mapSheet
    .getRange(2, 1, mapSheet.getLastRow() - 1, 2)
    .getValues()
    .forEach(([team, pax]) => {
      if (pax) paxTeam[pax] = { pax, team };
    });

  const rows = [[
    'Date', 'WeekStart', 'Pax', 'Team', 'AO', 'Counted', 'Reason'
  ]];

/* ---------- beatdowns (pax sheet) ---------- */

paxSheet
  .getRange(2, 1, paxSheet.getLastRow() - 1, 3)
  .getValues()
  .forEach(([date, ao, pax]) => {
    if (!date || !ao || !pax) return;
    if (isOutsideKog(date)) return;
    if (!paxTeam[pax]) return;

    rows.push([
      date,
      weekStart(date),
      paxTeam[pax].pax,
      paxTeam[pax].team,
      ao,
      true,
      ''
    ]);
  });
  /* ---------- 26KoG events (BO / PW / FNG) ---------- */

  const headers = kogSheet
    .getRange(1, 4, 1, kogSheet.getLastColumn() - 3)
    .getValues()[0];

  const dates = kogSheet
  .getRange(2, 2, kogSheet.getLastRow() - 1, 1) // ✅ column B
  .getValues();

  const data = kogSheet
    .getRange(2, 4, kogSheet.getLastRow() - 1, headers.length)
    .getValues();

  dates.forEach((r, i) => {
    const date = r[0];
    if (!date) return;
    if (isOutsideKog(date)) return;

  data[i].forEach((v, c) => {
    if (!v) return;

    const paxKey = headers[c];
    if (!paxTeam[paxKey]) return;

    // Split "PreWork, BlackOps" into separate events
    const events = String(v)
      .split(',')
      .map(e => e.trim())
      .filter(Boolean);

    events.forEach(event => {
      rows.push([
        date,
        weekStart(date),
        paxTeam[paxKey].pax,
        paxTeam[paxKey].team,
        event,
        true,
        ''
      ]);
    });
  });

});

