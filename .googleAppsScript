function addMissingPaxToWeeklyScores() {
  const ss = SpreadsheetApp.getActive();

  const scoreSheet = ss.getSheetByName('Score_PaxWeekly_Summary');
  const mapSheet = ss.getSheetByName('26KoGScoring');

  const scoreData = scoreSheet
    .getRange(2, 1, scoreSheet.getLastRow() - 1, 5)
    .getValues();

  const tz = Session.getScriptTimeZone();

  // normalize WeekStart to yyyy-MM-dd
  const fmtWeek = v =>
    Utilities.formatDate(new Date(v), tz, 'yyyy-MM-dd');

  // existing Week|Pax keys
  const existing = new Set(
    scoreData.map(r => `${fmtWeek(r[0])}|${r[1]}`)
  );

  // distinct weeks (normalized)
  const weeks = [...new Set(scoreData.map(r => fmtWeek(r[0])))];

  // pax → team map
  const paxTeam = {};
  mapSheet.getRange(2, 1, mapSheet.getLastRow() - 1, 2)
    .getValues()
    .forEach(([team, pax]) => {
      if (pax) paxTeam[pax] = team;
    });

  const rowsToAdd = [];

  weeks.forEach(week => {
    Object.entries(paxTeam).forEach(([pax, team]) => {
      const key = `${week}|${pax}`;
      if (!existing.has(key)) {
        rowsToAdd.push([
          week,  // normalized WeekStart
          pax,
          team,
          0,     // Raw
          0      // Score
        ]);
      }
    });
  });

  if (rowsToAdd.length) {
    scoreSheet
      .getRange(scoreSheet.getLastRow() + 1, 1, rowsToAdd.length, 5)
      .setValues(rowsToAdd);
  }
}
