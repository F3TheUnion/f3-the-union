function ghRequest_(url, method, payload) {
  const token = PropertiesService.getScriptProperties().getProperty('GITHUB_TOKEN');

  const params = {
    method,
    headers: {
      Authorization: `Bearer ${token}`,
      Accept: 'application/vnd.github+json'
    },
    muteHttpExceptions: false
  };

  if (payload) {
    params.contentType = 'application/json';
    params.payload = JSON.stringify(payload);
  }

  return JSON.parse(UrlFetchApp.fetch(url, params).getContentText());
}

function sheetToJSON(sheetName) {
  const ss = SpreadsheetApp.getActive();
  const sheet = ss.getSheetByName(sheetName);

  if (!sheet) {
    throw new Error(`Sheet not found: ${sheetName}`);
  }

  const values = sheet.getDataRange().getValues();
  if (values.length < 2) return [];

  const headers = values.shift();

  return values.map(row => {
    const obj = {};
    headers.forEach((h, i) => {
      obj[h] = row[i];
    });
    return obj;
  });
}

function commitFilesToGitHubSingleCommit(branch, message, files) {
  const repo = GITHUB_REPO;
  const base = `https://api.github.com/repos/${repo}`;

  // 1. get current HEAD
  const ref = ghRequest_(`${base}/git/refs/heads/${branch}`, 'get');
  const headSha = ref.object.sha;

  const commit = ghRequest_(`${base}/git/commits/${headSha}`, 'get');
  const baseTree = commit.tree.sha;

  // 3. create blobs
  const tree = [];

  Object.entries(files).forEach(([path, data]) => {
    const blob = ghRequest_(`${base}/git/blobs`, 'post', {
      content: JSON.stringify(data, null, 2)
    });

    tree.push({
      path,
      mode: '100644',
      type: 'blob',
      sha: blob.sha
    });
  });

  // 4. create tree
  const newTree = ghRequest_(`${base}/git/trees`, 'post', {
    base_tree: baseTree,
    tree
  });

  // 5. create commit
  const newCommit = ghRequest_(`${base}/git/commits`, 'post', {
    message: message,
    tree: newTree.sha,
    parents: [headSha]
  });

  // 6. move branch
  ghRequest_(`${base}/git/refs/heads/${branch}`, 'patch', {
    sha: newCommit.sha
  });

  Logger.log('The data was committed in ONE commit.');
}

