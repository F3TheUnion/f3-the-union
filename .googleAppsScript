    "FROM `f3data.analytics.event_info` " +
    "WHERE start_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 6 WEEK) " +
    "  AND CAST(region_org_id AS STRING) = '38363' " +
    "GROUP BY start_date " +
    "ORDER BY start_date DESC";

