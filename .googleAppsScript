function sendSlackDMByUsername_(username, text) {
  const userId = getSlackUserId(username);

  const openRes = UrlFetchApp.fetch(
    'https://slack.com/api/conversations.open',
    {
      method: 'post',
      contentType: 'application/json',
      headers: {
        Authorization: 'Bearer ' + slackBotToken
      },
      payload: JSON.stringify({ users: userId }),
      muteHttpExceptions: true
    }
  );

  const openData = JSON.parse(openRes.getContentText());
  if (!openData.ok) {
    throw new Error('Unable to open DM for ' + username + ': ' + openData.error);
  }

  const channelId = openData.channel.id;

  const postRes = UrlFetchApp.fetch(
    'https://slack.com/api/chat.postMessage',
    {
      method: 'post',
      contentType: 'application/json',
      headers: {
        Authorization: 'Bearer ' + slackBotToken
      },
      payload: JSON.stringify({
        channel: channelId,
        text
      }),
      muteHttpExceptions: true
    }
  );

  const postData = JSON.parse(postRes.getContentText());
  if (!postData.ok) {
    throw new Error('Unable to DM ' + username + ': ' + postData.error);
  }
}

