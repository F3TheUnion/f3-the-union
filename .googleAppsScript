function fmtWeek(v) {
  return Utilities.formatDate(
    new Date(v),
    Session.getScriptTimeZone(),
    'yyyy-MM-dd'
  );
}

function isOutsideKog(week) {
  return new Date(week) < KOG_START_DATE || new Date(week) > KOG_END_DATE;
}

function generateTeamScores() {
  const ss = SpreadsheetApp.getActive();
  const paxWeekly = ss.getSheetByName('Score_PaxWeekly_Summary');

  const data = paxWeekly.getRange(
    2, 1,
    paxWeekly.getLastRow() - 1,
    paxWeekly.getLastColumn()
  ).getValues();

  /* ---------- TEAM WEEKLY ---------- */

  let teamWeekly = ss.getSheetByName('Score_TeamWeekly');
  if (!teamWeekly) teamWeekly = ss.insertSheet('Score_TeamWeekly');
  teamWeekly.clearContents();

  const weeklyMap = {};

  data.forEach(([week, pax, team, raw, score]) => {
    if (isOutsideKog(week)) return;

    const key = week + '|' + team;
    if (!weeklyMap[key]) {
      weeklyMap[key] = { week, team, total: 0, count: 0 };
    }
    weeklyMap[key].total += score;
    weeklyMap[key].count++;
  });

  const weeklyRows = [['WeekStart', 'Team', 'AvgScore']];

  Object.values(weeklyMap).forEach(o => {
    weeklyRows.push([
      o.week,
      o.team,
      Math.round(o.total / o.count)
    ]);
  });

  teamWeekly.getRange(
    1, 1,
    weeklyRows.length,
    weeklyRows[0].length
  ).setValues(weeklyRows);

  teamWeekly.autoResizeColumns(1, weeklyRows[0].length);

  /* ---------- TEAM CUMULATIVE ---------- */

  let teamTotal = ss.getSheetByName('Score_TeamCumulative');
  if (!teamTotal) teamTotal = ss.insertSheet('Score_TeamCumulative');
  teamTotal.clearContents();

  const totalMap = {};

  data.forEach(([week, pax, team, raw, score]) => {
    if (isOutsideKog(week)) return;

    if (!totalMap[team]) {
      totalMap[team] = { total: 0, count: 0 };
    }
    totalMap[team].total += score;
    totalMap[team].count++;
  });

  const totalRows = [['Team', 'AvgScore']];

  Object.entries(totalMap).forEach(([team, o]) => {
    totalRows.push([
      team,
      Math.round(o.total / o.count)
    ]);
  });

  teamTotal.getRange(
    1, 1,
    totalRows.length,
    totalRows[0].length
  ).setValues(totalRows);

  teamTotal.autoResizeColumns(1, totalRows[0].length);
}
