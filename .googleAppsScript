/**
 * Generates Never Q data using user_id as the unique person key
 * and commits it to:
 *   data/never-q.json
 */
function exportNeverQDataToGitHub() {
const sql = `
  WITH region_attendance AS (
    SELECT
      a.user_id,
      a.start_date AS attendance_date,
      e.ao_name AS ao,
      a.f3_name AS pax,
      a.home_region_id,
      a.q_ind
    FROM \`f3data.analytics.attendance_info\` a
    INNER JOIN \`f3data.analytics.event_info\` e
      ON a.event_instance_id = e.id
    WHERE e.region_org_id = 38363
      AND e.ao_name IN (
        'The Fountain',
        'The Farm',
        'The Plant',
        'The Clocktower',
        'The Yard',
        'The Factory',
        'The Floor',
        'The Redzone',
        'The Show',
        'The Dock'
      )
      AND a.user_id IS NOT NULL
  ),

  attendance_60 AS (
    SELECT
      user_id,
      COUNT(*) AS bds_attended
    FROM region_attendance
    WHERE attendance_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 60 DAY)
    GROUP BY user_id
  ),

  last_attendance AS (
    SELECT
      user_id,
      pax,
      home_region_id,
      attendance_date AS last_attended_date,
      ao AS last_attended_ao
    FROM region_attendance
    QUALIFY ROW_NUMBER() OVER (
      PARTITION BY user_id
      ORDER BY attendance_date DESC
    ) = 1
  ),

  has_q AS (
    SELECT DISTINCT
      user_id
    FROM region_attendance
    WHERE q_ind = 1
  ),

  future_q AS (
    SELECT DISTINCT
      planned_q_user_id AS user_id
    FROM \`f3data.analytics.future_event_info\`
    WHERE region_org_id = 38363
      AND planned_q_user_id IS NOT NULL
      AND start_date >= CURRENT_DATE()
  )

  SELECT
    l.pax,
    a.user_id,
    l.home_region_id,
    a.bds_attended,
    l.last_attended_date,
    l.last_attended_ao,
    'Never Q' AS q_status
  FROM attendance_60 a
  LEFT JOIN has_q q
    ON q.user_id = a.user_id
  LEFT JOIN future_q f
    ON f.user_id = a.user_id
  LEFT JOIN last_attendance l
    ON l.user_id = a.user_id
  WHERE q.user_id IS NULL
    AND f.user_id IS NULL
  ORDER BY
    a.bds_attended DESC,
    l.last_attended_date DESC,
    l.pax
`;

  const result = runBigQuery(sql);
  const data = rowsToNeverQObjects(result.headers, result.rows);

  const payload = {
    generated_at: new Date().toISOString(),
    window_days: 60,
    region_org_id: 38363,
    report: 'never_q',
    identity_key: 'user_id',
    count: data.length,
    data: data
  };

  commitFilesToGitHubSingleCommit(
    NEVER_Q_DATA_BRANCH,
    'Update never-Q report',
    {
      'data/never-q.json': payload
    }
  );
}


/**
 * Converts BigQuery headers + rows into clean JSON objects.
 */
function rowsToNeverQObjects(headers, rows) {
  return rows.map(function(row) {
    const obj = {};

    headers.forEach(function(header, i) {
      let value = row[i];

      if (header === 'bds_attended') {
        value = Number(value || 0);
      }

      if (header === 'user_id' || header === 'home_region_id') {
        value = value === null || value === undefined ? null : String(value);
      }

      obj[header] = value;
    });

    return obj;
  });
}
