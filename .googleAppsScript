function applyWeeklyCaps() {
  const ss = SpreadsheetApp.getActive();
  const sheet = ss.getSheetByName('Fact_PaxEvents');

  const dataRange = sheet.getRange(2, 1, sheet.getLastRow() - 1, 7);
  const data = dataRange.getValues();

  /* ---------- reset flags (safe rerun) ---------- */

  data.forEach(r => {
    r[5] = true;
    if (r[4].toLowerCase() !== 'kog_bonus') {
      r[6] = '';
    }
  });

  /* ---------- de-duplicate same Pax + Date + AO ---------- */

  const seen = new Set();

  data.forEach(r => {

    // Skip KOG_BONUS rows entirely
    if ((r[4] ?? '').toString().trim().toUpperCase() === 'KOG_BONUS') {
      return;
    }

    const dateKey = Utilities.formatDate(
      new Date(r[0]),
      Session.getScriptTimeZone(),
      'yyyy-MM-dd'
    );

    const pax = r[2];
    const ao = r[4].toLowerCase();  // keep EXACTLY as before

    const key = `${dateKey}|${pax}|${ao}`;

    if (seen.has(key)) {
      r[5] = false;
      r[6] = 'Duplicate same-day';
    } else {
      seen.add(key);
    }
  });

  /* ---------- group ONLY counted rows by WeekStart + Pax ---------- */

  const groups = {};

  data.forEach(r => {
    if (!r[5]) return;
    const key = `${r[1]}|${r[2]}`;
    if (!groups[key]) groups[key] = [];
    groups[key].push(r);
  });

  /* ---------- apply weekly caps ---------- */

  Object.values(groups).forEach(group => {
    const beatdowns = [];
    const extras = [];

    group.forEach(r => {
      const ao = r[4].toLowerCase();
      
      if (ao === 'kog_bonus' || ao === 'fng') return;

      if (ao === 'prework') {
        extras.push(r);
      } else {
        beatdowns.push(r);
      }
    });

    beatdowns
      .sort((a, b) => new Date(a[0]) - new Date(b[0]))
      .slice(3)
      .forEach(r => {
        r[5] = false;
        r[6] = 'Beatdowns capped at 3';
      });

    extras
      .sort((a, b) => new Date(a[0]) - new Date(b[0]))
      .slice(2)
      .forEach(r => {
        r[5] = false;
        r[6] = 'Extra Credit Capped at 2';
      });
  });

  dataRange.setValues(data);
}
