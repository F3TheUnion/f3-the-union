  const sheet = writeToSheet('bd_attendance', result.headers, result.rows);

  // format date column as MM-dd
  if (sheet.getLastRow() > 1) {
    sheet.getRange(2, 1, sheet.getLastRow() - 1, 1).setNumberFormat("M-dd");
  }

  // increment counts from pax!G:G -- for non slack users
  const ss = SpreadsheetApp.getActive();
  const paxSheet = ss.getSheetByName('pax');

  const paxLastRow = paxSheet.getLastRow();
  if (paxLastRow < 2) return;

  const paxDates = paxSheet.getRange(2, 7, paxLastRow - 1, 1)
    .getValues()
    .flat()
    .filter(String)
    .map(function (d) {
      return normalizeSheetDate(d);
    });

  const bdLastRow = sheet.getLastRow();
  if (bdLastRow < 2) return;

  const bdRange = sheet.getRange(2, 1, bdLastRow - 1, 2);
  const bdData = bdRange.getValues();

  const dateMap = {};
  bdData.forEach(function (r, i) {
    dateMap[normalizeSheetDate(r[0])] = i;
  });

  paxDates.forEach(function (d) {
    if (dateMap[d] !== undefined) {
      bdData[dateMap[d]][1] = Number(bdData[dateMap[d]][1] || 0) + 1;
    }
  });

  bdRange.setValues(bdData);

  // re-apply format after writing updated values
  if (sheet.getLastRow() > 1) {
    sheet.getRange(2, 1, sheet.getLastRow() - 1, 1).setNumberFormat("M-dd");
  }

  sheet.autoResizeColumns(1, 2);
}

function normalizeSheetDate(value) {
  if (Object.prototype.toString.call(value) === '[object Date]') {
    return Utilities.formatDate(value, Session.getScriptTimeZone(), 'yyyy-MM-dd');
  }
  return String(value).substring(0, 10);
}

function getUniquePaxCountBQ() {
  const sql =
    "SELECT " +
    "  DATE_SUB(a.start_date, INTERVAL EXTRACT(DAYOFWEEK FROM a.start_date) - 1 DAY) AS start_of_week, " +
    "  COUNT(DISTINCT a.f3_name) AS distinct_pax " +
    "FROM `f3data.analytics.attendance_info` a " +
    "WHERE DATE_SUB(a.start_date, INTERVAL EXTRACT(DAYOFWEEK FROM a.start_date) - 1 DAY) >= DATE_SUB(CURRENT_DATE(), INTERVAL 10 WEEK) " +
    "  AND CAST(a.home_region_id AS STRING) = '38363' " +
    "GROUP BY start_of_week " +
    "ORDER BY start_of_week";

  const result = runBigQuery(sql);

  const sheet = SpreadsheetApp.getActive().getSheetByName('distinct_pax');
  sheet.getRange("A:B").clearContent();

  const output = [result.headers].concat(
    result.rows.map(function (row) {
      return [new Date(row[0] + 'T00:00:00'), row[1]];
    })
  );

  if (output.length > 0) {
    sheet.getRange(1, 1, output.length, 2).setValues(output);
  }

  // display dates as MM-dd
  if (output.length > 1) {
    sheet.getRange(2, 1, output.length - 1, 1).setNumberFormat("MM-dd");
  }

  /* ---- increment from pax! (unique pax per week) ---- */

  const ss = SpreadsheetApp.getActive();
  const paxSheet = ss.getSheetByName('pax');

  if (paxSheet.getLastRow() < 2 || sheet.getLastRow() < 2) return;

  const paxData = paxSheet
    .getRange(2, 7, paxSheet.getLastRow() - 1, 2) // G:H (date, pax)
    .getValues()
    .filter(function (r) { return r[0] && r[1]; });

  function weekStart(d) {
    const dt = new Date(d);
    dt.setHours(0, 0, 0, 0);
    dt.setDate(dt.getDate() - dt.getDay());
    return Utilities.formatDate(dt, Session.getScriptTimeZone(), 'yyyy-MM-dd');
  }

  const weeklyPax = new Set();
  paxData.forEach(function (row) {
    weeklyPax.add(weekStart(row[0]) + '|' + row[1]);
  });

  const range = sheet.getRange(2, 1, sheet.getLastRow() - 1, 2);
  const data = range.getValues();

  const map = {};
  data.forEach(function (r, i) {
    map[toDateKey(r[0])] = i;
  });

  weeklyPax.forEach(function (k) {
    const wk = k.split('|')[0];
    if (map[wk] !== undefined) {
      data[map[wk]][1] = Number(data[map[wk]][1] || 0) + 1;
    }
  });

  range.setValues(data);
  sheet.getRange(2, 1, sheet.getLastRow() - 1, 1).setNumberFormat("MM-dd");
  sheet.autoResizeColumns(1, 2);
}

/**
 * Runs the rolling 60-day Q report and commits it as JSON to GitHub.
 *
 * Output file in repo:
 *   data/q_report_rolling.json
 */
function getQReportRollingBQJsonToGitHub() {
const sql = `
  WITH base AS (
    SELECT
      a.user_id,
      a.start_date AS attendance_date,
      e.ao_name AS ao,
      a.f3_name AS pax,
      a.q_ind
    FROM \`f3data.analytics.attendance_info\` a
    LEFT JOIN \`f3data.analytics.event_info\` e
      ON a.event_instance_id = e.id
    WHERE e.region_org_id = 38363
      AND a.start_date >= DATE_SUB(CURRENT_DATE(), INTERVAL 60 DAY)
      AND e.ao_name IN (
        'The Fountain',
        'The Farm',
        'The Plant',
        'The Clocktower',
        'The Yard',
        'The Factory',
        'The Floor',
        'The Redzone',
        'The Show',
        'The Dock'
      )
      AND a.user_id IS NOT NULL
  ),

  pax_list AS (
    SELECT
      user_id,
      ARRAY_AGG(pax IGNORE NULLS ORDER BY attendance_date DESC LIMIT 1)[OFFSET(0)] AS pax
    FROM base
    GROUP BY user_id
  ),

  last_q AS (
    SELECT
      user_id,
      attendance_date AS last_q_date,
      ao AS last_q_ao
    FROM base
    WHERE q_ind = 1
    QUALIFY ROW_NUMBER() OVER (
      PARTITION BY user_id
      ORDER BY attendance_date DESC
    ) = 1
  ),

  future_q AS (
    SELECT
      planned_q_user_id AS user_id,
      ao_name AS planned_q_ao,
      start_date AS planned_q_date
    FROM \`f3data.analytics.future_event_info\`
    WHERE region_org_id = 38363
      AND planned_q_user_id IS NOT NULL
      AND start_date >= CURRENT_DATE()
      AND start_date <= DATE_ADD(CURRENT_DATE(), INTERVAL 30 DAY)
      AND ao_name IN (
        'The Fountain',
        'The Farm',
        'The Plant',
        'The Clocktower',
        'The Yard',
        'The Factory',
        'The Floor',
        'The Redzone',
        'The Show',
        'The Dock'
      )
    QUALIFY ROW_NUMBER() OVER (
      PARTITION BY planned_q_user_id
      ORDER BY start_date ASC
    ) = 1
  )

  SELECT
    p.pax,
    p.user_id,
    l.last_q_date,
    l.last_q_ao,
    f.planned_q_date,
    f.planned_q_ao,
    CASE
      WHEN f.user_id IS NOT NULL THEN 'Future Q Scheduled'
      WHEN l.last_q_date IS NULL THEN 'Never Q'
      ELSE 'Has Q'
    END AS q_status,
    CASE
      WHEN f.user_id IS NOT NULL THEN -DATE_DIFF(f.planned_q_date, CURRENT_DATE(), DAY)
      WHEN l.last_q_date IS NULL THEN COUNT(b.attendance_date)
      ELSE COUNTIF(b.attendance_date > l.last_q_date)
    END AS attended_since_last_q
  FROM pax_list p
  LEFT JOIN last_q l
    ON l.user_id = p.user_id
  LEFT JOIN future_q f
    ON f.user_id = p.user_id
  LEFT JOIN base b
    ON b.user_id = p.user_id
  GROUP BY
    p.pax,
    p.user_id,
    l.last_q_date,
    l.last_q_ao,
    f.user_id,
    f.planned_q_date,
    f.planned_q_ao
  ORDER BY
    q_status DESC,
    attended_since_last_q DESC,
    p.pax
`;

  const result = runBigQuery(sql);
  const data = rowsToObjects(result.headers, result.rows);

  const payload = {
    generated_at: new Date().toISOString(),
    window_days: 60,
    region_org_id: 38363,
    count: data.length,
    data: data
  };

  const branch = 'main'; // or your publish branch, such as 'gh-pages'
  const message = 'Update rolling 60-day Q report';

  commitFilesToGitHubSingleCommit(branch, message, {
    'data/q_report_rolling.json': payload
  });
}

