/**
 * Helper to find a chart by its title on the "Charts" sheet.
 *
 * @param {string} title
 * @return {EmbeddedChart}
 */
function getChartByTitle_(title) {
  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName('Charts');
  if (!sheet) {
    throw new Error("Sheet named 'Charts' not found.");
  }

  const chart = sheet
    .getCharts()
    .find((c) => c.getOptions().get('title') === title);

  if (!chart) {
    throw new Error(
      "Cannot find chart titled '" + title + "' in the 'Charts' sheet."
    );
  }

  return chart;
}

/**
 * Uploads a PNG blob to Slack using the new external upload flow:
 *   1) files.getUploadURLExternal
 *   2) POST binary to upload_url
 *   3) files.completeUploadExternal
 *
 * @param {Blob}   blob       PNG image blob from chart.getAs('image/png')
 * @param {string} title      Title for the file in Slack
 * @param {string} channelId  Slack channel ID (e.g. 'C03SC7HLN66')
 */
function uploadChartBlobToSlack_(blob, title, channelId) {
  if (typeof slackBotToken === 'undefined' || !slackBotToken) {
    throw new Error('slackBotToken is not defined.');
  }

  const bytes = blob.getBytes();
  const length = bytes.length;
  const filename = title + '.png';

  // --- DEBUG: log what we're about to send ---
  console.log('Preparing upload: filename =', filename, 'length =', length);

  // 1) Get upload URL & file_id
  const getUrlResp = UrlFetchApp.fetch(
    'https://slack.com/api/files.getUploadURLExternal',
    {
      method: 'post',
      headers: {
        Authorization: 'Bearer ' + slackBotToken,
        'Content-Type': 'application/x-www-form-urlencoded; charset=utf-8',
      },
      payload: {
        filename: filename,
        length: String(length), // Slack expects a string in form-encoded body
      },
      muteHttpExceptions: true,
    }
  );

  const status = getUrlResp.getResponseCode();
  const text = getUrlResp.getContentText();

  console.log('getUploadURLExternal status =', status);
  console.log('getUploadURLExternal body   =', text);

  if (status !== 200) {
    throw new Error(
      'Slack files.getUploadURLExternal HTTP ' + status + ': ' + text
    );
  }

  const getUrlBody = JSON.parse(text);
  if (!getUrlBody.ok) {
    const meta = getUrlBody.response_metadata
      ? ' meta=' + JSON.stringify(getUrlBody.response_metadata)
      : '';
    throw new Error(
      'Slack files.getUploadURLExternal error: ' +
        getUrlBody.error +
        meta
    );
  }

  const uploadUrl = getUrlBody.upload_url;
  const fileId = getUrlBody.file_id;

  // 2) Upload file data (binary POST to upload_url)
  const uploadResp = UrlFetchApp.fetch(uploadUrl, {
    method: 'post', // Slack docs show POST here
    contentType: 'application/octet-stream',
    payload: bytes,
    muteHttpExceptions: true,
  });

  console.log('upload POST status =', uploadResp.getResponseCode());
  console.log('upload POST body   =', uploadResp.getContentText());

  if (uploadResp.getResponseCode() >= 400) {
    throw new Error(
      'Error uploading file data to Slack upload URL: HTTP ' +
        uploadResp.getResponseCode() +
        ' ' +
        uploadResp.getContentText()
    );
  }

  // 3) Complete the upload & share to the specified channel
  const completeResp = UrlFetchApp.fetch(
    'https://slack.com/api/files.completeUploadExternal',
    {
      method: 'post',
      headers: {
        Authorization: 'Bearer ' + slackBotToken,
        'Content-Type': 'application/x-www-form-urlencoded; charset=utf-8',
      },
      payload: {
        // form-encoded, per Slack docs
        files: JSON.stringify([{ id: fileId, title: title }]),
        channel_id: channelId,
        initial_comment: title,
      },
      muteHttpExceptions: true,
    }
  );

  console.log('completeUploadExternal status =', completeResp.getResponseCode());
  console.log('completeUploadExternal body   =', completeResp.getContentText());

  if (completeResp.getResponseCode() !== 200) {
    throw new Error(
      'Slack files.completeUploadExternal HTTP ' +
        completeResp.getResponseCode() +
        ': ' +
        completeResp.getContentText()
    );
  }

  const completeBody = JSON.parse(completeResp.getContentText());
  if (!completeBody.ok) {
    const meta2 = completeBody.response_metadata
      ? ' meta=' + JSON.stringify(completeBody.response_metadata)
      : '';
    throw new Error(
      'Slack files.completeUploadExternal error: ' +
        completeBody.error +
        meta2
    );
  }
}

