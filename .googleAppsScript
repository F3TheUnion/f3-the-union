function generatePaxWeeklyScores() {
  const ss = SpreadsheetApp.getActive();
  const fact = ss.getSheetByName('Fact_PaxEvents');

  let out = ss.getSheetByName('Score_PaxWeekly_Summary');
  if (!out) out = ss.insertSheet('Score_PaxWeekly_Summary');
  out.clearContents();

  const data = fact.getRange(2, 1, fact.getLastRow() - 1, 7).getValues();
  const map = {};

  data.forEach(r => {
    if (!r[5]) return; // Counted only

    const week = r[1];
    if (isOutsideKog(week)) return;

    const pax = r[2];
    const team = r[3];

    const key = week + '|' + pax;
    if (!map[key]) {
      map[key] = { week, pax, team, raw: 0 };
    }
    if (r[4] && r[4].toLowerCase() === 'kog_bonus') {
      const bonus = parseInt(r[6], 10) || 0;
      map[key].raw += bonus;
    } else {
      map[key].raw += 1;
    }
  });

  const rows = [[ 'WeekStart', 'Pax', 'Team', 'Raw', 'Score' ]];

  // build base rows
  Object.values(map).forEach(o => {
    rows.push([
      o.week,
      o.pax,
      o.team,
      o.raw,
      Math.round((o.raw / 3) * 100)
    ]);
  });

  out.getRange(1, 1, rows.length, rows[0].length).setValues(rows);
  out.autoResizeColumns(1, rows[0].length);

  addMissingPaxToWeeklyScores();
}
