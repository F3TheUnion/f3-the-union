  { ao: 'The Redzone',    channelId: SLACK_CHANNEL_THE_REDZONE,    enabled: true, weeksAhead: 2 },
  { ao: 'The Show',       channelId: SLACK_CHANNEL_THE_SHOW,       enabled: true, weeksAhead: 1 },
  { ao: 'The Dock',       channelId: SLACK_CHANNEL_THE_DOCK,       enabled: true, weeksAhead: 2 },
  { ao: 'The Cafeteria',  channelId: SLACK_CHANNEL_THE_CAFETERIA,  enabled: true, weeksAhead: 2 },
  { ao: 'The Forge',      channelId: SLACK_CHANNEL_THE_FORGE,      enabled: true, weeksAhead: 2 },
  { ao: 'The Breakroom',  channelId: SLACK_CHANNEL_THE_BREAKROOM,  enabled: true, weeksAhead: 2 },
];

// ── Main ─────────────────────────────────────────────────────────────────────

/**
 * Kept so the existing time-based trigger (bound to this name) keeps firing.
 * The work now lives in postOpenQSlotsToSiteQs().
 */
function postOpenQSlotsToAOChannels() {
  postOpenQSlotsToSiteQs();
}

/**
 * DMs each site Q the open Q slots at the AO(s) they run.
 *
 * A site Q who covers more than one AO (e.g. Peach: The Breakroom + The Clocktower)
 * gets ONE DM listing every AO. If the site Q can't be resolved in Slack, that AO's
 * slots fall back to being posted in the AO channel so they still get seen.
 */
function postOpenQSlotsToSiteQs() {
  const enabled = AO_CONFIG.filter(function(c) { return c.enabled; });
  if (!enabled.length) return;

  // Use the largest weeksAhead across enabled AOs so one query covers all of them
  const maxWeeks = Math.max(...enabled.map(function(c) {
    return c.weeksAhead || DEFAULT_WEEKS_AHEAD;
  }));

  const aoNames = enabled.map(function(c) { return "'" + c.ao + "'"; }).join(',');

  const sql = `
    SELECT ao_name, start_date
    FROM \`f3data.analytics.future_event_info\`
    WHERE region_org_id = 38363
      AND planned_q_user_id IS NULL
      AND start_date >= CURRENT_DATE()
      AND start_date <= DATE_ADD(CURRENT_DATE(), INTERVAL ${maxWeeks} WEEK)
      AND ao_name IN (${aoNames})
    ORDER BY ao_name, start_date`;

  const { headers, rows } = runBigQuery(sql);
  const aoIdx   = headers.indexOf('ao_name');
  const dateIdx = headers.indexOf('start_date');

  // Group rows by AO
  const slotsByAO = {};
  rows.forEach(function(row) {
    const ao = row[aoIdx];
    if (!slotsByAO[ao]) slotsByAO[ao] = [];
    slotsByAO[ao].push(row[dateIdx]); // 'YYYY-MM-DD'
  });

  const siteQMap = getAoToSiteQMap();

  // Bucket each AO's open slots under the site Q who owns it, so a site Q
  // covering several AOs gets a single DM.
  const bucketsBySiteQ = {};   // siteQ name -> [{ config, weeks, slots }]
  const orphans        = [];   // AOs with no site Q mapped -> channel fallback

  enabled.forEach(function(config) {
    const weeks    = config.weeksAhead || DEFAULT_WEEKS_AHEAD;
    const cutoff   = getCutoffDate_(weeks);
    const allSlots = slotsByAO[config.ao] || [];

    // Trim to this AO's specific window in case it's shorter than maxWeeks
    const slots = allSlots.filter(function(d) { return d <= cutoff; });

    if (!slots.length) {
      Logger.log(config.ao + ': no open slots in next ' + weeks + ' week(s), skipping');
      return;
    }

    const entry = { config: config, weeks: weeks, slots: slots };
    const siteQ = siteQMap[aoSlug_(config.ao)];

    if (!siteQ) {
      Logger.log(config.ao + ': no site Q in AO_SITEQ, falling back to channel');
      orphans.push(entry);
      return;
    }

    if (!bucketsBySiteQ[siteQ]) bucketsBySiteQ[siteQ] = [];
    bucketsBySiteQ[siteQ].push(entry);
  });

  Object.keys(bucketsBySiteQ).forEach(function(siteQ) {
    const entries = bucketsBySiteQ[siteQ];

    try {
      sendSiteQDM_(siteQ, buildSiteQMessage_(entries));
      Logger.log(siteQ + ': DMed ' + entries.length + ' AO(s), ' +
        entries.reduce(function(n, e) { return n + e.slots.length; }, 0) + ' slot(s)');
    } catch (err) {
      Logger.log('site Q ' + siteQ + ' not reachable (' + err.message +
        '), falling back to channel for ' + entries.length + ' AO(s)');
      entries.forEach(function(entry) { postEntryToChannel_(entry); });
    }
  });

  orphans.forEach(function(entry) { postEntryToChannel_(entry); });
}

// ── Open Q slot message builders ─────────────────────────────────────────────

/** 'The Fountain' -> 'the_fountain', to join AO_CONFIG against AO_SITEQ. */
function aoSlug_(aoName) {
  return aoName.toLowerCase().trim().replace(/\s+/g, '_');
}

function weeksLabel_(weeks) {
  return weeks === 1 ? 'next week' : 'next ' + weeks + ' weeks';
}

function slotLines_(slots) {
  return slots.map(function(d) { return '• ' + formatQDate_(d); }).join('\n');
}

/** The DM body — one section per AO the site Q covers. */
function buildSiteQMessage_(entries) {
  const intro = entries.length === 1
    ? '*Open Q slots at ' + entries[0].config.ao + ' (' + weeksLabel_(entries[0].weeks) + '):*\n'
    : '*Open Q slots you need to fill:*\n\n';

  const body = entries.length === 1
    ? slotLines_(entries[0].slots)
    : entries.map(function(e) {
        return '*' + e.config.ao + '* (' + weeksLabel_(e.weeks) + ')\n' + slotLines_(e.slots);
      }).join('\n\n');

  return intro + body + '\n\n' +
    'Type `/calendar` to fill a slot, or put out a call in your AO channel. :microphone:';
}

/** The original channel post, used as the fallback path. */
function postEntryToChannel_(entry) {
  const text =
    '*Open Q slots for the ' + weeksLabel_(entry.weeks) + ' at ' + entry.config.ao + ':*\n' +
    slotLines_(entry.slots) + '\n' +
    'Type `/calendar` to grab a slot — open Q spots filling fast! :microphone:';

  postMessageToSlack_(getTargetChannel_(entry.config.channelId), text);
  Logger.log(entry.config.ao + ': posted ' + entry.slots.length + ' slot(s) to channel');
}

/**
 * DMs a site Q by F3 name. When DEBUG_ON, every DM goes to the Comms Q
 * (COMMZQ) instead, tagged with who it was meant for.
 */
function sendSiteQDM_(siteQName, text) {
  if (DEBUG_ON) {
    sendSlackDMByUsername_(COMMZQ, '_(DM intended for ' + siteQName + ')_\n' + text);
    return;
  }
  sendSlackDMByUsername_(siteQName, text);
}

// ── Helpers ───────────────────────────────────────────────────────────────────

function postMessageToSlack_(channelId, text) {
  const res = UrlFetchApp.fetch('https://slack.com/api/chat.postMessage', {
    method: 'post',
    contentType: 'application/json',
    headers: { Authorization: 'Bearer ' + slackBotToken },
    payload: JSON.stringify({ channel: channelId, text: text }),
    muteHttpExceptions: true
  });

  const body = JSON.parse(res.getContentText());
  if (!body.ok) {
    throw new Error('chat.postMessage failed for ' + channelId + ': ' + body.error);
  }
}

function getCutoffDate_(weeks) {
  const d = new Date();
  d.setDate(d.getDate() + weeks * 7);
  return Utilities.formatDate(d, Session.getScriptTimeZone(), 'yyyy-MM-dd');
}

function formatQDate_(dateStr) {
  const d = new Date(dateStr + 'T00:00:00');
  return Utilities.formatDate(d, Session.getScriptTimeZone(), 'EEE, MMM d');
}