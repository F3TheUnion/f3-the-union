/**
 * Convert runBigQuery() headers + rows into JSON objects.
 */
function rowsToObjects(headers, rows) {
  return rows.map(function(row) {
    const obj = {};

    headers.forEach(function(header, i) {
      let value = row[i];

      if (header === 'attended_since_last_q') {
        value = Number(value || 0);
      }

      obj[header] = value;
    });

    return obj;
  });
}

function toDateKey(value) {
  if (Object.prototype.toString.call(value) === '[object Date]') {
    return Utilities.formatDate(value, Session.getScriptTimeZone(), 'yyyy-MM-dd');
  }
  return String(value).substring(0, 10);
}
/**
 * Run a BigQuery query and return headers + rows
 */
function runBigQuery(query) {
  const request = {
    query: query,
    useLegacySql: false
  };

  let result = BigQuery.Jobs.query(request, BQ_PROJECT_ID);
  const jobId = result.jobReference.jobId;

  // wait for completion
  while (!result.jobComplete) {
    Utilities.sleep(500);
    result = BigQuery.Jobs.getQueryResults(BQ_PROJECT_ID, jobId);
  }

  const headers = result.schema.fields.map(f => f.name);
  const rows = [];

  let pageToken = null;
  do {
    const page = pageToken
      ? BigQuery.Jobs.getQueryResults(BQ_PROJECT_ID, jobId, { pageToken })
      : result;

    (page.rows || []).forEach(r => {
      rows.push(r.f.map(c => c.v));
    });

    pageToken = page.pageToken;
  } while (pageToken);

  return { headers, rows };
}

/**
 * Write results to a sheet
 */
function writeToSheet(sheetName, headers, rows) {
  const ss = SpreadsheetApp.getActive();
  const sheet = ss.getSheetByName(sheetName) || ss.insertSheet(sheetName);

  sheet.clearContents();

  const output = [headers, ...rows];

  if (output.length > 0) {
    sheet.getRange(1, 1, output.length, output[0].length).setValues(output);
    sheet.autoResizeColumns(1, output[0].length);
  }

  return sheet;
}

